<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GhPrApi</RootNamespace>
    <AssemblyName>GhPrApi</AssemblyName>
    <!-- Committed packages.lock.json, restored in locked mode by CI and the Dockerfile: an
         unexpected transitive change fails the build instead of entering the published image
         silently. A vulnerable transitive (GHSA-v5pm-xwqc-g5wc) already reached this once.
         Scoped to this project, the only one that ships. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Top-level statements generate an internal Program class; the endpoint tests need it
         to build a WebApplicationFactory<Program> host. -->
    <InternalsVisibleTo Include="GhPrApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- Microsoft.AspNetCore.OpenApi still declares only Microsoft.OpenApi >= 2.0.0, and NuGet
         resolves the lowest match, which is the version vulnerable to GHSA-v5pm-xwqc-g5wc
         (stack overflow on circular schema refs). Keep an explicit reference to force a fixed
         one. /openapi/v1.json is covered by an endpoint test so this stays honest.

         Held on 2.x, and it is not a version-bump away. Microsoft.OpenApi 3.x pairs with
         Microsoft.AspNetCore.OpenApi 11.x on net11.0; the net10.0 line declares 2.0.0 and is
         binary-incompatible with 3.x. Forcing 3.9.0 was tried and fails twice over:

           1. compile: the bundled XmlCommentGenerator assigns IOpenApiMediaType.Example,
              read-only in 3.x
                error CS0200: Property or indexer 'IOpenApiMediaType.Example'
                cannot be assigned to
           2. runtime, after stripping that generator so it does build: GET /openapi/v1.json
              returns 500
                System.MissingMethodException: Method not found:
                'IDictionary`2<String,Microsoft.OpenApi.OpenApiMediaType>
                 Microsoft.OpenApi.OpenApiResponse.get_Content()'

         The second is inside shipped AspNetCore.OpenApi IL, so no project-side change fixes
         it. Revisit only when this project moves to net11.0 with AspNetCore.OpenApi 11.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>
</Project>
