<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GhPrApi</RootNamespace>
    <AssemblyName>GhPrApi</AssemblyName>
    <!-- Committed packages.lock.json, restored in locked mode by CI and the Dockerfile: an
         unexpected transitive change fails the build instead of entering the published image
         silently. A vulnerable transitive (GHSA-v5pm-xwqc-g5wc) already reached this once.
         Scoped to this project, the only one that ships. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Top-level statements generate an internal Program class; the endpoint tests need it
         to build a WebApplicationFactory<Program> host. -->
    <InternalsVisibleTo Include="GhPrApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.0 transitively pulls Microsoft.OpenApi 2.0.0, which is
         vulnerable to GHSA-v5pm-xwqc-g5wc (stack overflow on circular schema refs); pin the fix. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
</Project>
