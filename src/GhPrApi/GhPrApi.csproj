<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GhPrApi</RootNamespace>
    <AssemblyName>GhPrApi</AssemblyName>
    <!-- Committed packages.lock.json, restored in locked mode by CI and the Dockerfile: an
         unexpected transitive change fails the build instead of entering the published image
         silently. A vulnerable transitive (GHSA-v5pm-xwqc-g5wc) already reached this once.
         Scoped to this project, the only one that ships. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Top-level statements generate an internal Program class; the endpoint tests need it
         to build a WebApplicationFactory<Program> host. -->
    <InternalsVisibleTo Include="GhPrApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite 10.0.10 transitively pulls the SQLitePCLRaw 2.1.11 family, whose
         bundled SQLite is covered by GHSA-2m69-gcr7-jv3q (high). Pin the current 3.x family
         rather than the minimum that clears the advisory, so the native SQLite build stays
         current. bundle pulls config, which pulls lib. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- Microsoft.AspNetCore.OpenApi declares only Microsoft.OpenApi >= 2.0.0, and NuGet
         resolves the lowest match, which is the version vulnerable to GHSA-v5pm-xwqc-g5wc
         (stack overflow on circular schema refs). Keep an explicit reference to force a fixed
         one. /openapi/v1.json is covered by an endpoint test so this stays honest.

         2.11.0 is the newest 2.x and IS the correct latest version here, not a workaround.
         Per the vendor's own upgrade guide, 3.x is not applicable to this project:

           "If you are using this library with AspNetCore OpenAPI versions = 10.X then you
            must remain on version 2.x as it's not compatible with version 3 or above of
            this library."
           https://github.com/microsoft/OpenAPI.NET/blob/main/docs/upgrade-guide-3.md

         Every released Microsoft.AspNetCore.OpenApi 10.x (10.0.0 through 10.0.10) depends on
         Microsoft.OpenApi 2.0.0; 3.x pairs with AspNetCore.OpenApi 11.x on net11.0. Forcing
         3.9.0 fails to compile (CS0200: IOpenApiMediaType.Example is read-only in 3.x) and,
         once that generator is stripped, 500s at runtime with MissingMethodException on
         OpenApiResponse.get_Content. Revisit only when this project targets net11.0. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>
</Project>
