GITHUB_TOKEN=github_pat_or_ghp_token
GITHUB_OWNER=ivuorinen
GITHUB_CACHE_TTL_SECONDS=300
GITHUB_REPOSITORY_LIMIT=1000
GITHUB_PR_LIMIT_PER_REPO=100
GITHUB_STATUS_CHECK_LIMIT=100

# Durable cache tier. CachePath must sit on a mounted volume to survive a redeploy.
GITHUB_CACHE_PATH=/data/cache.db
# TTL for a PR whose checks are still running. Failing checks use twice this; an all-green
# verdict is cached for 6 hours, keyed by head commit SHA so a push invalidates it.
GITHUB_STATUS_CACHE_TTL_SECONDS=30

# Image tag compose.yml uses when pulling instead of building. Pin to an immutable tag
# (e.g. sha-7047b17) for a reproducible deploy; `latest` moves on every merge to main.
IMAGE_TAG=latest
