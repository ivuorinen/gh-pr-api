<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- RestorePackagesWithLockFile is set per-project in src/GhPrApi, NOT here. Setting it
         solution-wide also locks the test project, whose lockfile records GhPrApi's transitive
         graph; Dependabot regenerates lockfiles only in the directory of the manifest it
         updated, so any src package bump left the test lockfile stale and failed locked-mode
         restore with NU1004. Only the shipped app needs the guarantee. -->
  </PropertyGroup>
</Project>
